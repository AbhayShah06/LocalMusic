<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#73E6AD</item>
        <item name="android:windowBackground">#090A0C</item>
        <item name="android:navigationBarColor">#090A0C</item>
        <item name="android:statusBarColor">#090A0C</item><item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="LibraryTab"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">42dp</item><item name="android:layout_marginEnd">8dp</item><item name="android:background">@drawable/bg_tab</item><item name="android:gravity">center</item><item name="android:minWidth">82dp</item><item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item><item name="android:textColor">@drawable/tab_text</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item></style>
    <style name="PlayerIcon"><item name="android:layout_width">42dp</item><item name="android:layout_height">48dp</item><item name="android:background">?android:attr/selectableItemBackgroundBorderless</item><item name="android:gravity">center</item><item name="android:textColor">#FAFAFA</item><item name="android:textSize">32sp</item></style>
    <style name="PlayerIcon.Primary" parent="PlayerIcon"><item name="android:layout_width">48dp</item><item name="android:background">@drawable/bg_play_button</item><item name="android:textColor">#07130D</item><item name="android:textSize">20sp</item></style>
</resources>

