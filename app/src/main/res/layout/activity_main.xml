<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B0B0C" android:fitsSystemWindows="true">
    <View android:layout_width="match_parent" android:layout_height="3dp" android:background="#FF5C35" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="@dimen/page_gutter" android:paddingTop="20dp" android:paddingEnd="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERSONAL PLAYER" android:textColor="#FF805F" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.18" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Your music." android:textColor="#F6F1E8" android:textSize="@dimen/title_size" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
            <TextView android:id="@+id/source" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_source_chip" android:clickable="true" android:focusable="true" android:gravity="center" android:minWidth="104dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:text="This phone  ▾" android:textColor="#F6F1E8" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/more" android:layout_width="64dp" android:layout_height="64dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:gravity="center" android:text="⋮" android:textColor="#F6F1E8" android:textSize="32sp" android:contentDescription="More options" />
    </LinearLayout>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginStart="@dimen/page_gutter" android:layout_marginTop="2dp" android:layout_marginEnd="@dimen/page_gutter" android:background="@drawable/bg_search" android:hint="Find a song, artist, or album" android:inputType="text" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:textColor="#F6F1E8" android:textColorHint="#77736D" android:textSize="15sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none">
        <LinearLayout android:id="@+id/tabs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="@dimen/page_gutter" android:paddingEnd="@dimen/page_gutter">
            <TextView android:id="@+id/forYou" style="@style/LibraryTab" android:text="For You" />
            <TextView android:id="@+id/songs" style="@style/LibraryTab" android:text="Songs" />
            <TextView android:id="@+id/albums" style="@style/LibraryTab" android:text="Albums" />
            <TextView android:id="@+id/artists" style="@style/LibraryTab" android:text="Artists" />
            <TextView android:id="@+id/playlists" style="@style/LibraryTab" android:text="Playlists" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/page_gutter" android:paddingTop="13dp" android:paddingEnd="@dimen/page_gutter" android:paddingBottom="7dp" android:text="Loading your music…" android:textAllCaps="true" android:letterSpacing="0.08" android:textColor="#8A867F" android:textSize="10sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/tracks" android:layout_width="match_parent" android:layout_height="match_parent" android:cacheColorHint="#0B0B0C" android:clipToPadding="false" android:divider="@android:color/transparent" android:dividerHeight="4dp" android:listSelector="@android:color/transparent" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="14dp" />
        <LinearLayout android:id="@+id/permissionPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp" android:visibility="gone">
            <TextView android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_art_placeholder" android:gravity="center" android:text="LM" android:textColor="#FF805F" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="Bring in your library" android:textColor="#F6F1E8" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/permissionExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Allow audio access to browse and play music stored on this phone. Your library stays on your device." android:textColor="#A6A19A" android:textSize="14sp" android:lineSpacingExtra="3dp" />
            <Button android:id="@+id/grantPermission" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:background="@drawable/bg_primary_button" android:text="Allow music access" android:textAllCaps="false" android:textColor="#170A06" android:textStyle="bold" />
            <Button android:id="@+id/permissionSettings" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@android:color/transparent" android:text="Open app settings" android:textAllCaps="false" android:textColor="#FF805F" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/miniPlayer" android:layout_width="match_parent" android:layout_height="74dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_mini_player" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="8dp">
        <ImageView android:id="@+id/miniArtwork" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_art_placeholder" android:contentDescription="Album artwork" android:scaleType="centerCrop" android:src="@android:drawable/ic_media_play" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Nothing playing" android:textColor="#F6F1E8" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/nowPlayingArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="Choose a song" android:textColor="#99948C" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/previous" android:layout_width="42dp" android:layout_height="50dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Previous" android:padding="11dp" android:src="@drawable/ic_skip_previous" android:tint="#F6F1E8" />
        <ImageButton android:id="@+id/playPause" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_play_button" android:contentDescription="Play or pause" android:padding="14dp" android:src="@drawable/ic_play" android:tint="#170A06" />
        <ImageButton android:id="@+id/next" android:layout_width="42dp" android:layout_height="50dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Next" android:padding="11dp" android:src="@drawable/ic_skip_next" android:tint="#F6F1E8" />
    </LinearLayout>
    <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginBottom="4dp" android:max="1000" android:padding="0dp" android:progressTint="#FF5C35" android:thumbTint="@android:color/transparent" />
</LinearLayout>
