<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nowPlayingRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#09090A" android:fitsSystemWindows="true">
    <ImageView android:id="@+id/fullBackgroundArtwork" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.28" android:contentDescription="@null" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_now_playing_scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="22dp" android:paddingTop="8dp" android:paddingEnd="22dp" android:paddingBottom="20dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp">
            <ImageButton android:id="@+id/closeNowPlaying" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="start|center_vertical" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Close player" android:padding="11dp" android:src="@drawable/ic_chevron_down" android:tint="#F7F4EE" />
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center" android:letterSpacing="0.16" android:text="NOW PLAYING" android:textColor="#B8B3AB" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/fullMore" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:gravity="center" android:text="&#8942;" android:textColor="#F7F4EE" android:textSize="28sp" android:contentDescription="Current song options" />
        </FrameLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginTop="10dp" android:layout_marginEnd="8dp" android:layout_marginBottom="26dp" android:background="@drawable/bg_art_card" android:clipToOutline="true" android:elevation="18dp">
            <ImageView android:id="@+id/fullArtwork" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Album artwork" android:scaleType="centerCrop" />
        </FrameLayout>
        <TextView android:id="@+id/fullTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#F7F4EE" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/fullArtist" android:layout_width="match_parent" android:layout_height="42dp" android:clickable="true" android:ellipsize="end" android:focusable="true" android:gravity="center_vertical" android:maxLines="1" android:textColor="#B8B3AB" android:textSize="16sp" />
        <SeekBar android:id="@+id/fullSeek" android:layout_width="match_parent" android:layout_height="26dp" android:max="1000" android:paddingStart="0dp" android:paddingEnd="0dp" android:progressBackgroundTint="#45FFFFFF" android:progressTint="#F7F4EE" android:thumbTint="#F7F4EE" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="28dp" android:paddingStart="2dp" android:paddingEnd="2dp">
            <TextView android:id="@+id/fullElapsed" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:text="0:00" android:textColor="#A7A29B" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/fullDuration" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end" android:gravity="center_vertical" android:text="–:––" android:textColor="#A7A29B" android:textSize="12sp" android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="78dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/fullPrevious" android:layout_width="64dp" android:layout_height="64dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Previous" android:padding="18dp" android:src="@drawable/ic_skip_previous" android:tint="#F7F4EE" />
            <ImageButton android:id="@+id/fullPlayPause" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:background="@drawable/bg_play_button_modern" android:contentDescription="Play or pause" android:padding="22dp" android:src="@drawable/ic_play" android:tint="#111112" />
            <ImageButton android:id="@+id/fullNext" android:layout_width="64dp" android:layout_height="64dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Next" android:padding="18dp" android:src="@drawable/ic_skip_next" android:tint="#F7F4EE" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:layout_marginTop="2dp" android:gravity="center" android:orientation="horizontal">
            <LinearLayout android:id="@+id/fullPlaylist" style="@style/NowPlayingAction" android:contentDescription="Add to playlist"><ImageView style="@style/NowPlayingActionIcon" android:src="@drawable/ic_playlist_add" /><TextView style="@style/NowPlayingActionLabel" android:text="Playlist" /></LinearLayout>
            <LinearLayout android:id="@+id/fullLyrics" style="@style/NowPlayingAction" android:layout_marginStart="10dp" android:contentDescription="Lyrics"><ImageView style="@style/NowPlayingActionIcon" android:src="@drawable/ic_lyrics" /><TextView style="@style/NowPlayingActionLabel" android:text="Lyrics" /></LinearLayout>
            <LinearLayout android:id="@+id/fullQueue" style="@style/NowPlayingAction" android:layout_marginStart="10dp" android:contentDescription="Queue"><ImageView style="@style/NowPlayingActionIcon" android:src="@drawable/ic_queue" /><TextView style="@style/NowPlayingActionLabel" android:text="Queue" /></LinearLayout>
            <LinearLayout android:id="@+id/fullRepeat" style="@style/NowPlayingAction" android:layout_marginStart="10dp" android:contentDescription="Repeat off"><ImageView android:id="@+id/fullRepeatIcon" style="@style/NowPlayingActionIcon" android:src="@drawable/ic_repeat" /><TextView android:id="@+id/fullRepeatLabel" style="@style/NowPlayingActionLabel" android:text="Repeat off" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
