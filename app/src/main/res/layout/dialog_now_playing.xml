<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nowPlayingRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:background="#0B0B0C" android:paddingStart="24dp" android:paddingTop="28dp" android:paddingEnd="24dp" android:paddingBottom="28dp">
    <TextView android:id="@+id/closeNowPlaying" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center" android:text="⌄" android:textColor="#F6F1E8" android:textSize="30sp" android:contentDescription="Close full screen player" />
    <ImageView android:id="@+id/fullArtwork" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:layout_marginBottom="28dp" android:adjustViewBounds="true" android:background="@drawable/bg_art_placeholder" android:contentDescription="Album artwork" android:scaleType="centerCrop" />
    <TextView android:id="@+id/fullTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#F6F1E8" android:textSize="27sp" android:textStyle="bold" />
    <TextView android:id="@+id/fullArtist" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="1" android:textColor="#FF805F" android:textSize="16sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
    <SeekBar android:id="@+id/fullSeek" android:layout_width="match_parent" android:layout_height="32dp" android:max="1000" android:progressTint="#FF5C35" android:thumbTint="#FF805F" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/fullPrevious" style="@style/PlayerIcon" android:layout_width="72dp" android:layout_height="72dp" android:text="‹" android:textSize="42sp" />
        <TextView android:id="@+id/fullPlayPause" style="@style/PlayerIcon.Primary" android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="▶" android:textSize="25sp" />
        <TextView android:id="@+id/fullNext" style="@style/PlayerIcon" android:layout_width="72dp" android:layout_height="72dp" android:text="›" android:textSize="42sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center" android:orientation="horizontal">
        <Button android:id="@+id/fullPlaylist" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_source_chip" android:text="Add to playlist" android:textAllCaps="false" android:textColor="#F6F1E8" />
        <Button android:id="@+id/fullLyrics" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_source_chip" android:text="Lyrics" android:textAllCaps="false" android:textColor="#F6F1E8" />
        <Button android:id="@+id/fullQueue" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@drawable/bg_source_chip" android:text="Queue" android:textAllCaps="false" android:textColor="#F6F1E8" />
    </LinearLayout>
</LinearLayout>
