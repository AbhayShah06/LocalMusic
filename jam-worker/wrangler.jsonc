{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localmusic-jam",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "SITE_ORIGIN": "https://abhayshah06.github.io",
    "SEARCH_API": "https://localmusic-jam.vercel.app/api/search"
  },
  "ratelimits": [
    { "name": "ROOM_CREATION_LIMIT", "namespace_id": "51001", "simple": { "limit": 30, "period": 60 } },
    { "name": "ROOM_SEARCH_LIMIT", "namespace_id": "51002", "simple": { "limit": 120, "period": 60 } },
    { "name": "ROOM_ACTION_LIMIT", "namespace_id": "51003", "simple": { "limit": 300, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "JAM_ROOMS", "class_name": "JamRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JamRoom"] }],
  "observability": { "enabled": true }
}
